\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{unibaselcolor}[2026/08/27 University of Basel colour palette]

\RequirePackage{xcolor}

% -----------------------------------------------------------------------------
% University of Basel corporate palette (RGB)
% Source: unibasel_colours.pdf (10 colours; order is defined, first is Mint).
% We define *all* colours from the palette here, even if not used by the theme.
% -----------------------------------------------------------------------------

% 1 — Mint (primary supporting colour)
\definecolor{unibasMint}{RGB}{165,215,210}

% 2 — Turquoise
\definecolor{unibasTurquoise}{RGB}{30,165,165}

% 3 — Anthracite (dark text alternative)
\definecolor{unibasAnthracite}{RGB}{45,55,60}

% 4 — Grey
\definecolor{unibasGrey}{RGB}{140,145,150}

% 5 — Basel Red (primary brand colour)
\definecolor{unibasRed}{RGB}{210,5,55}

% 6 — Pink
\definecolor{unibasPink}{RGB}{235,130,155}

% 7 — Light Grey
\definecolor{unibasLightGrey}{RGB}{190,195,200}

% 8 — Petrol (deep teal)
\definecolor{unibasPetrol}{RGB}{0,110,110}

% 9 — Black
\definecolor{unibasBlack}{RGB}{0,0,0}

% 10 — White
\definecolor{unibasWhite}{RGB}{255,255,255}

% Convenience aliases (British spelling, etc.)
\colorlet{unibasGray}{unibasGrey}

% -----------------------------------------------------------------------------
% Derived neutrals (not part of the corporate palette)
% -----------------------------------------------------------------------------

% Very light neutral used for block bodies. Kept subtle to stay print-friendly.
\definecolor{unibasPaper}{RGB}{248,248,248}

% Colour for content that is deliberately de-emphasised in a progressive build
% (see \ghost / \reveal in the theme). Light enough to recede, dark enough to
% stay legible from the back of the room.
\colorlet{unibasGhost}{unibasLightGrey}

% -----------------------------------------------------------------------------
% Semantic aliases for data series, so that slides, poster and paper agree.
% Dark red = initial distribution / experimental data; petrol = engineered or
% fitted model; pink = a secondary series.
% -----------------------------------------------------------------------------
\colorlet{unibasData}{unibasRed}
\colorlet{unibasModel}{unibasPetrol}
\colorlet{unibasSeriesB}{unibasPink}
